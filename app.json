{
  "expo": {
    "name": "MeToYou",
    "slug": "metoyou",
    "version": "1.0.0",
    "scheme": "metoyou",
    "android": {
      "package": "com.wizrd.metoyou",
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/adaptive-foreground.png",
        "backgroundColor": "#000000"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WAKE_LOCK",
        "android.permission.BLUETOOTH",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "ios": {
      "icon": "./src/assets/AppIcon.icon",
      "bitcode": false
    },
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false
        }
      ],
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true
        }
      ],
      "expo-asset",
      "expo-notifications",
      "expo-video",
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Allow MeToYou to use your camera for video calls.",
          "microphonePermission": "Allow MeToYou to use your microphone for calls and voice messages."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow MeToYou to save Flicks to your photo library.",
          "savePhotosPermission": "Allow MeToYou to save media to your library.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": [
            "photo",
            "video",
            "audio",
            "photo",
            "video",
            "audio"
          ]
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "dc81f97d-7623-4ad2-84fa-2a52f2a89468"
      }
    },
    "owner": "wizrd"
  }
}
