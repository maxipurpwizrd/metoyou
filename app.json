{
  "expo": {
    "name": "MeToYou",
    "slug": "metoyou",
    "version": "1.0.0",
    "scheme": "metoyou",
    "android": {
      "package": "com.wizrd.metoyou",
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/adaptive-foreground.png",
        "backgroundColor": "#000000"
      }
    },
    "ios": {
      "icon": "./src/assets/AppIcon.icon"
    },
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-audio",
      "expo-asset",
      "expo-video",
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Allow MeToYou to use your camera for video calls.",
          "microphonePermission": "Allow MeToYou to use your microphone for calls and voice messages."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow MeToYou to save Flicks to your photo library.",
          "savePhotosPermission": "Allow MeToYou to save media to your library.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": [
            "photo",
            "video",
            "audio"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "dc81f97d-7623-4ad2-84fa-2a52f2a89468"
      }
    },
    "owner": "wizrd"
  }
}
